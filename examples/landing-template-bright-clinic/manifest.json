          "key": "reviews",
          "type": "list",
          "label": "Reviews",
          "default": [
            {
              "quote": "The first dentist I've not been nervous about. Everything was explained before it happened.",
              "author": "Nora P."
            },
            {
              "quote": "Booked on Monday, seen on Wednesday. The price was exactly what they told me.",
              "author": "Sam R."
            },
            {
              "quote": "My kids actually ask when their next visit is. That says it all.",
              "author": "Lina C."
            }
          ]
        }
      ]
