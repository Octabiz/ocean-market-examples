    {
      "key": "faq",
      "name": "Questions and answers",
      "template": "sections/faq.html",
      "styles": "sections/faq.css",
      "mobile_styles": "sections/faq.mobile.css",
      "settings": [
        {
          "key": "eyebrow",
          "type": "text",
          "label": "Small line above the heading",
          "default": "FAQ"
        },
        {
          "key": "heading",
          "type": "text",
          "label": "Heading",
          "default": "Good to know before your visit"
        },
        {
          "key": "questions",
          "type": "list",
          "label": "Questions",
          "default": [
            {
              "question": "Do you take my insurance?",
              "answer": "We work with most major plans. Call us with your plan name and we'll check before you book."
            },
            {
              "question": "How soon can I be seen?",
              "answer": "Usually within the same week. For pain or a broken tooth we keep same-day slots free."
            },
            {
              "question": "Can I bring my children?",
              "answer": "Yes. We see children from their first tooth, and short first visits help them feel at ease."
            },
            {
              "question": "How much will it cost?",
              "answer": "You get a written price before any treatment starts, and there are no surprise extras."
            }
          ]
        }
      ]
    },
